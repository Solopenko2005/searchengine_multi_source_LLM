<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- ... существующие изменения ... -->

    <changeSet id="1" author="developer">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="site"/>
            </not>
        </preConditions>
        <createTable tableName="site">
            <column name="id" type="SERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="status_time" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_error" type="TEXT"/>
            <column name="url" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Создание таблицы Lemma -->
    <changeSet id="2" author="developer">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="lemma"/>
            </not>
        </preConditions>
        <createTable tableName="lemma">
            <column name="id" type="SERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="site_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_lemma_site" references="site(id)"/>
            </column>
            <column name="lemma" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="frequency" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="lemma" columnNames="lemma, site_id" constraintName="uc_lemma_site"/>
    </changeSet>

    <!-- Создание таблицы Page -->
    <changeSet id="3" author="developer">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="page"/>
            </not>
        </preConditions>
        <createTable tableName="page">
            <column name="id" type="SERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="site_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_page_site" references="site(id)"/>
            </column>
            <column name="path" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="TEXT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="page" indexName="idx_path">
            <column name="path"/>
        </createIndex>
    </changeSet>

    <!-- Создание таблицы SearchIndex -->
    <changeSet id="4" author="developer">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="search_index"/>
            </not>
        </preConditions>
        <createTable tableName="search_index">
            <column name="id" type="SERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="page_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_searchindex_page" references="page(id)"/>
            </column>
            <column name="lemma_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_searchindex_lemma" references="lemma(id)"/>
            </column>
            <column name="ranking" type="FLOAT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Создание таблицы Topic -->
    <changeSet id="5" author="developer">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="topic"/>
            </not>
        </preConditions>
        <createTable tableName="topic">
            <column name="id" type="SERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="page_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_topic_page" references="page(id)"/>
            </column>
            <column name="site_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_topic_site" references="site(id)"/>
            </column>
            <column name="title" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="order_num" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="lemma_count" type="INT" defaultValue="0">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Индексы для таблицы topic -->
        <createIndex tableName="topic" indexName="idx_topic_site_id">
            <column name="site_id"/>
        </createIndex>

        <createIndex tableName="topic" indexName="idx_topic_page_id_order">
            <column name="page_id"/>
            <column name="order_num"/>
        </createIndex>

        <createIndex tableName="topic" indexName="idx_topic_lemma_count">
            <column name="lemma_count" descending="true"/>
        </createIndex>

        <comment>Создание таблицы topic для хранения извлеченных тем/разделов с веб-страниц</comment>
    </changeSet>

    <!-- Добавление поля topic_count в таблицу page (опционально, для статистики) -->
    <changeSet id="6" author="developer">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="page"/>
            <not>
                <columnExists tableName="page" columnName="topic_count"/>
            </not>
        </preConditions>
        <addColumn tableName="page">
            <column name="topic_count" type="INT" defaultValue="0">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <comment>Добавление счетчика тем в таблицу page для быстрого доступа к статистике</comment>
    </changeSet>

    <!-- Создание таблицы для связи тем с леммами (опционально, для улучшенного поиска) -->
    <changeSet id="7" author="developer">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="topic_lemma"/>
            </not>
        </preConditions>
        <createTable tableName="topic_lemma">
            <column name="id" type="SERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="topic_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_topiclemma_topic" references="topic(id)"/>
            </column>
            <column name="lemma_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_topiclemma_lemma" references="lemma(id)"/>
            </column>
            <column name="frequency" type="INT" defaultValue="1">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="topic_lemma" indexName="idx_topiclemma_topic">
            <column name="topic_id"/>
        </createIndex>

        <createIndex tableName="topic_lemma" indexName="idx_topiclemma_lemma">
            <column name="lemma_id"/>
        </createIndex>

        <addUniqueConstraint
                tableName="topic_lemma"
                columnNames="topic_id, lemma_id"
                constraintName="uc_topiclemma_unique"/>

        <comment>Создание таблицы для связи тем с леммами для улучшенного поиска по темам</comment>
    </changeSet>

    <changeSet id="8" author="developer">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="topic_group"/>
            </not>
        </preConditions>
        <createTable tableName="topic_group">
            <column name="id" type="SERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="content_summary" type="TEXT"/>
            <column name="frequency" type="INT" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="site_count" type="INT" defaultValue="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="topic_group" indexName="idx_topicgroup_frequency">
            <column name="frequency" descending="true"/>
        </createIndex>
    </changeSet>

    <changeSet id="9" author="developer">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="topic"/>
            <not>
                <columnExists tableName="topic" columnName="topic_group_id"/>
            </not>
        </preConditions>
        <addColumn tableName="topic">
            <column name="topic_group_id" type="INT">
                <constraints nullable="true" foreignKeyName="fk_topic_topicgroup"
                             referencedTableName="topic_group" referencedColumnNames="id"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="10" author="developer">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="topic_group_key_lemmas"/>
            </not>
        </preConditions>
        <createTable tableName="topic_group_key_lemmas">
            <column name="topic_group_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_topicgrouplemmas_group"
                             referencedTableName="topic_group" referencedColumnNames="id"/>
            </column>
            <column name="lemma" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="topic_group_key_lemmas" indexName="idx_topicgrouplemmas_lemma">
            <column name="lemma"/>
        </createIndex>
    </changeSet>

    <!-- Тип источника (сайт / загруженный документ) -->
    <changeSet id="11" author="developer">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="site"/>
            <not>
                <columnExists tableName="site" columnName="source_type"/>
            </not>
        </preConditions>
        <addColumn tableName="site">
            <column name="source_type" type="VARCHAR(20)" defaultValue="WEBSITE">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <comment>Тип источника: WEBSITE (сайт, обходимый краулером) или DOCUMENT (загруженный DOCX/PDF документ)</comment>
    </changeSet>

    <!-- Оригинальное имя загруженного файла документа -->
    <changeSet id="12" author="developer">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="page"/>
            <not>
                <columnExists tableName="page" columnName="original_file_name"/>
            </not>
        </preConditions>
        <addColumn tableName="page">
            <column name="original_file_name" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <comment>Оригинальное имя файла для страниц, созданных из загруженных документов DOCX/PDF</comment>
    </changeSet>

    <!-- Владелец пользовательского документа для изоляции данных между аккаунтами -->
    <changeSet id="13" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="page"/>
            <not>
                <columnExists tableName="page" columnName="owner_id"/>
            </not>
        </preConditions>
        <addColumn tableName="page">
            <column name="owner_id" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <createIndex tableName="page" indexName="idx_page_owner_id">
            <column name="owner_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="14" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="assistant_profile"/>
            </not>
        </preConditions>
        <createTable tableName="assistant_profile">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="owner_id" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_assistant_profile_owner"/>
            </column>
            <column name="instructions" type="TEXT" defaultValue="">
                <constraints nullable="false"/>
            </column>
            <column name="document_ids" type="TEXT" defaultValue="">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="15" author="codex">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="indexing_job"/></not>
        </preConditions>
        <createTable tableName="indexing_job">
            <column name="id" type="VARCHAR(36)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="owner_id" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="source_type" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="source_name" type="VARCHAR(500)"><constraints nullable="false"/></column>
            <column name="source_url" type="VARCHAR(1000)"/>
            <column name="site_id" type="INT"/>
            <column name="state" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="stage" type="VARCHAR(80)"><constraints nullable="false"/></column>
            <column name="progress_percent" type="INT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="discovered_items" type="INT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="processed_items" type="INT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="failed_items" type="INT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="searchable_items" type="INT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="cancel_requested" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="error_message" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="started_at" type="TIMESTAMP"/>
            <column name="finished_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="indexing_job" indexName="idx_indexing_job_owner"><column name="owner_id"/></createIndex>
        <createIndex tableName="indexing_job" indexName="idx_indexing_job_state"><column name="state"/></createIndex>
        <createIndex tableName="indexing_job" indexName="idx_indexing_job_created"><column name="created_at"/></createIndex>
    </changeSet>

    <changeSet id="16" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="page"/>
            <tableExists tableName="site"/>
            <columnExists tableName="page" columnName="path"/>
            <columnExists tableName="site" columnName="url"/>
        </preConditions>
        <modifyDataType tableName="page" columnName="path" newDataType="VARCHAR(2048)"/>
        <modifyDataType tableName="site" columnName="url" newDataType="VARCHAR(1000)"/>
    </changeSet>

    <changeSet id="17" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="search_index"/>
            <tableExists tableName="page"/>
        </preConditions>
        <createIndex tableName="search_index" indexName="idx_search_index_lemma_page">
            <column name="lemma_id"/>
            <column name="page_id"/>
        </createIndex>
        <createIndex tableName="search_index" indexName="idx_search_index_page_lemma">
            <column name="page_id"/>
            <column name="lemma_id"/>
        </createIndex>
        <createIndex tableName="page" indexName="idx_page_site_id">
            <column name="site_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="18" author="codex">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="assistant_profile"/>
                <not><columnExists tableName="assistant_profile" columnName="source_ids"/></not>
            </and>
        </preConditions>
        <addColumn tableName="assistant_profile">
            <column name="source_ids" type="TEXT" defaultValue="">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="19" author="codex">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="site"/>
                <not><columnExists tableName="site" columnName="owner_id"/></not>
            </and>
        </preConditions>
        <addColumn tableName="site">
            <column name="owner_id" type="VARCHAR(255)"/>
        </addColumn>
        <createIndex tableName="site" indexName="idx_site_owner_id"><column name="owner_id"/></createIndex>
        <sql>
            UPDATE site s SET owner_id = owners.owner_id
            FROM (SELECT site_id, MIN(owner_id) AS owner_id FROM page
                  WHERE owner_id IS NOT NULL AND owner_id &lt;&gt; '' GROUP BY site_id) owners
            WHERE s.id = owners.site_id AND s.owner_id IS NULL
        </sql>
    </changeSet>

    <changeSet id="20" author="codex">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="workspace_group"/></not></preConditions>
        <createTable tableName="workspace_group">
            <column name="id" type="BIGSERIAL" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="name" type="VARCHAR(120)"><constraints nullable="false"/></column>
            <column name="owner_id" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="invite_code" type="VARCHAR(36)"><constraints nullable="false" unique="true" uniqueConstraintName="uc_workspace_group_invite"/></column>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="workspace_group" indexName="idx_workspace_group_owner"><column name="owner_id"/></createIndex>
        <createTable tableName="workspace_membership">
            <column name="id" type="BIGSERIAL" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="group_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_workspace_membership_group" referencedTableName="workspace_group" referencedColumnNames="id" deleteCascade="true"/></column>
            <column name="user_id" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="joined_at" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="workspace_membership" columnNames="group_id,user_id" constraintName="uc_workspace_membership_user"/>
        <createIndex tableName="workspace_membership" indexName="idx_workspace_membership_user"><column name="user_id"/></createIndex>
    </changeSet>

    <changeSet id="21" author="codex">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="assistant_profile"/>
                <not><columnExists tableName="assistant_profile" columnName="detected_topics"/></not>
            </and>
        </preConditions>
        <addColumn tableName="assistant_profile">
            <column name="detected_topics" type="TEXT" defaultValue="">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
