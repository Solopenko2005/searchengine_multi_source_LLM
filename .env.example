# Database
DB_URL=jdbc:postgresql://localhost:5432/search_engine
DB_USERNAME=postgres
DB_PASSWORD=change-me

# OpenAI API (do not commit a real key)
OPENAI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=1600

# Local authentication
SECURITY_MODE=basic
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me

# External authorization service (registration + session login)
AUTH_SERVICE_ENABLED=true
AUTH_SERVICE_URL=http://localhost:5555
REGISTRATION_DEFAULT_ROLE=USER
# Comma-separated accounts that become administrators when first registered
BOOTSTRAP_ADMIN_EMAILS=admin@example.com

# Production OAuth2/OIDC (used when SECURITY_MODE=jwt)
AUTH_ISSUER_URI=
AUTH_JWK_SET_URI=
AUTH_AUDIENCE=search-engine-api
AUTH_ROLES_CLAIM=roles
AUTH_PRINCIPAL_CLAIM=sub
CORS_ALLOWED_ORIGINS=http://localhost:8080
ASSISTANT_RATE_LIMIT_PER_MINUTE=30

# SMTP for password recovery (use an application password, not the mailbox password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Document indexing
DOCUMENT_INDEXING_ENABLED=true
DOCUMENT_MAX_FILE_SIZE=200MB
DOCUMENT_MAX_REQUEST_SIZE=1GB
DOCUMENT_MAX_FILE_SIZE_BYTES=209715200

# Optional scientific providers
SCOPUS_API_KEY=
