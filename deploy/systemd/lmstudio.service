[Unit]
Description=LM Studio embedding server for Scientific Search
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=scientific
Group=scientific
Environment=HOME=/home/scientific
Environment=PATH=/home/scientific/.lmstudio/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
WorkingDirectory=/home/scientific
TimeoutStartSec=900
ExecStartPre=-/home/scientific/.lmstudio/bin/lms daemon down
ExecStartPre=/bin/sleep 2
ExecStartPre=/home/scientific/.lmstudio/bin/lms daemon up
ExecStartPre=/bin/sleep 3
ExecStartPre=/home/scientific/.lmstudio/bin/lms load text-embedding-nomic-embed-text-v1.5 --identifier text-embedding-nomic-embed-text-v1.5 --yes
ExecStart=/home/scientific/.lmstudio/bin/lms server start --bind 0.0.0.0 --port 1234
ExecStop=/home/scientific/.lmstudio/bin/lms server stop
ExecStop=/home/scientific/.lmstudio/bin/lms daemon down

[Install]
WantedBy=multi-user.target
