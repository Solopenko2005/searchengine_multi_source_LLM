# Public address. Point the domain's A/AAAA record to the VPS before launch.
APP_HOST=search.example.ru
APP_PUBLIC_URL=https://search.example.ru

# PostgreSQL. Use unique randomly generated values in .env.production.
POSTGRES_DB=search_engine
POSTGRES_USER=search_app
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Authentication service secrets.
REDIS_PASSWORD=replace-with-a-different-long-random-password
AUTH_JWT_SECRET=replace-with-at-least-48-random-characters
BOOTSTRAP_ADMIN_EMAILS=admin@example.ru

# Yandex SMTP application password. Never commit the real values.
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TEST_CONNECTION=true

# Yandex AI Studio generates answers. Create the API key for a service account
# with ai.languageModels.user and never commit its value. The folder id is not a secret.
LLM_PROVIDER=Yandex AI Studio
LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
LLM_API_KEY=
YANDEX_FOLDER_ID=
LLM_MODEL=aliceai-llm

# Local Qwen remains a no-token-cost fallback when the cloud API or network is unavailable.
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=local
LLM_FALLBACK_BASE_URL=http://host.docker.internal:1235/v1
LLM_FALLBACK_API_KEY=lm-studio
LLM_FALLBACK_MODEL=local-qwen3-4b
LLM_FALLBACK_TIMEOUT_SECONDS=120

# LM Studio serves embeddings on 1234. A dedicated llama-server serves the
# fallback Qwen on 1235. Both ports must stay closed publicly.
LLM_INFERENCE_PORT=1235
LLM_CPU_THREADS=8
LLM_DRAFT_CPU_THREADS=2
LLM_CONTEXT_SIZE=4096
LLM_SPECULATIVE_DECODING=false
# Topic analysis uses the same Yandex provider and the RAG-oriented model.
LLM_BACKGROUND_PROVIDER=Yandex AI Studio
LLM_BACKGROUND_BASE_URL=https://ai.api.cloud.yandex.net/v1
LLM_BACKGROUND_API_KEY=
YANDEX_BACKGROUND_FOLDER_ID=
LLM_BACKGROUND_MODEL=yandexgpt-5.1
LLM_BACKGROUND_PORT=1236
LLM_BACKGROUND_CPU_THREADS=2
LLM_BACKGROUND_CONTEXT_SIZE=4096
LLM_BACKGROUND_NICE=10
EMBEDDING_BASE_URL=http://host.docker.internal:1234/v1
EMBEDDING_API_KEY=lm-studio
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
OPENAI_TIMEOUT_SECONDS=60
OPENAI_RETRY_ATTEMPTS=3
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_MAX_CONCURRENT_REQUESTS=8
OPENAI_QUEUE_TIMEOUT_MILLIS=3000
OPENAI_BACKGROUND_TIMEOUT_SECONDS=45
OPENAI_BACKGROUND_MAX_OUTPUT_TOKENS=192
OPENAI_CIRCUIT_FAILURE_THRESHOLD=2
OPENAI_CIRCUIT_COOLDOWN_SECONDS=30
OPENAI_RESPONSE_CACHE_TTL_SECONDS=600
ASSISTANT_RAG_MAX_DOCUMENTS=6
ASSISTANT_RAG_MAX_CHARS_PER_DOCUMENT=2000
ASSISTANT_RAG_MAX_INPUT_CHARS=14000
ASSISTANT_RAG_LOCAL_CONTEXT_CHARS=720
ASSISTANT_RAG_MAX_DOCUMENTS_PER_SOURCE=2
ASSISTANT_EMBEDDING_BATCH_SIZE=128
ASSISTANT_EMBEDDING_SCAN_BATCH_SIZE=256
ASSISTANT_QUERY_CACHE_TTL_SECONDS=900
ASSISTANT_EMBEDDING_RETRY_DELAY_SECONDS=300
ASSISTANT_SLO_MAX_FALLBACK_RATE=0.01

# Application limits suitable for the 12 GB pilot VPS.
SEARCH_JAVA_OPTIONS=-Xms512m -Xmx2g -XX:+UseG1GC
AUTH_JAVA_OPTIONS=-Xms128m -Xmx512m
EMAIL_JAVA_OPTIONS=-Xms64m -Xmx256m
INDEXING_SITE_PARALLELISM=4
INDEXING_CRAWL_PARALLELISM=8
INDEXING_MAX_PAGES_PER_SITE=1000
ASSISTANT_RATE_LIMIT_PER_MINUTE=20

# Optional provider keys.
SCOPUS_API_KEY=
